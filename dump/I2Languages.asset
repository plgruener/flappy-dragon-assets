    - Term: D_WORLD.PARADISE_LOST.NAME
      TermType: 0
      Languages:
      - Paradise Lost
      - Paraíso perdido
      - Das verlorene Paradies
      - Paradis perdu
      - Paradiso perduto
      - Het verloren paradijs
      - Paraíso perdido
      - Потерянный рай
