    - Term: S_SETTINGS.STORE_POWERUPS
      TermType: 0
      Languages:
      - Store powerups
      - Almacenar potenciadores
      - Powerups speichern
      - Stocker des bonus
      - Conservare potenziamenti
      - Power-ups opslaan
      - Armazenar potenciadores
      - Хранение бонусов
      - パワーアップを保存する
