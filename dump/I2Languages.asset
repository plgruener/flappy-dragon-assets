      TermType: 0
      Languages:
      - '{[PRIMARY_VALUE]} dimensional augment refreshes.'
      - '{[PRIMARY_VALUE]} actualizaciones de aumentos dimensionales.'
      - '{[PRIMARY_VALUE]} Aktualisierungen dimensionaler Verstärkungen.'
      - '{[PRIMARY_VALUE]} actualisations d''augmentations dimensionnelles.'
